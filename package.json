{
  "name": "bb-plugin-gearshift",
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "bb": ">=0.50",
    "bbPluginSdk": ">=0.6.157"
  },
  "bb": {
    "name": "Gearshift",
    "description": "Routes every message to the right model and effort for its size, on any provider. Per-thread toggle, cache-aware, with analytics.",
    "branding": {
      "icon": "./assets/icon.svg",
      "experimental_icons": {
        "gearshift": "./assets/icon.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.157",
    "@pierre/diffs": "~1.6.4",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "semver": "^7.8.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "build": "bb plugin build",
    "marketplace:check": "node scripts/marketplace-sync.mjs --dry-run --marketplace \"${MARKETPLACE_DIR:-/tmp/marketplace}\"",
    "diagrams": "node scripts/render-diagrams.mjs"
  }
